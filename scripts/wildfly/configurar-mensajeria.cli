# =============================================================================
#  MediConecta - confiabilidad de la mensajeria (Entrega 3) en WildFly
# =============================================================================
#
#  Se ejecuta con el servidor YA LEVANTADO con el perfil standalone-full.xml:
#
#      bin\jboss-cli.bat --connect --file=configurar-mensajeria.cli
#
#  Es idempotente: se puede correr varias veces.
#
#  1) Persistencia del broker (ActiveMQ Artemis embebido). Los mensajes
#     PERSISTENT que envia NotificadorTurnos se escriben en el journal
#     (standalone/data/activemq/journal) antes de confirmarse, asi que un
#     reinicio del servidor no los pierde. Es el valor por omision de WildFly;
#     se fija explicitamente para que quede documentado.
#
#  2) Reintentos y Dead Letter Queue de la cola de confirmaciones. Si
#     ReceptorConfirmacion falla con un mensaje (rollback de su transaccion),
#     el broker lo reintenta hasta 3 veces con 1 s de espera y despues lo mueve
#     a ColaConfirmacionesDLQ, que consume MonitorColaMuerta.
#     Las colas declaradas con @JMSDestinationDefinition usan la direccion
#     "jms.queue.<destinationName>" (ver mensajeria.DestinosJms).
# =============================================================================

/subsystem=messaging-activemq/server=default:write-attribute(name=persistence-enabled, value=true)

if (outcome != success) of /subsystem=messaging-activemq/server=default/address-setting=jms.queue.ColaConfirmacionesMediConecta:read-resource
    /subsystem=messaging-activemq/server=default/address-setting=jms.queue.ColaConfirmacionesMediConecta:add(dead-letter-address=jms.queue.ColaConfirmacionesDLQMediConecta, expiry-address=jms.queue.ExpiryQueue, max-delivery-attempts=3, redelivery-delay=1000)
else
    /subsystem=messaging-activemq/server=default/address-setting=jms.queue.ColaConfirmacionesMediConecta:write-attribute(name=dead-letter-address, value=jms.queue.ColaConfirmacionesDLQMediConecta)
    /subsystem=messaging-activemq/server=default/address-setting=jms.queue.ColaConfirmacionesMediConecta:write-attribute(name=max-delivery-attempts, value=3)
    /subsystem=messaging-activemq/server=default/address-setting=jms.queue.ColaConfirmacionesMediConecta:write-attribute(name=redelivery-delay, value=1000)
end-if

echo "Mensajeria: journal persistente, 3 reintentos y DLQ ColaConfirmacionesDLQMediConecta. Recargando el servidor..."

reload
